{
  "compilerOptions": {
    "target": "ESNext",
    "module": "node16",
    "moduleResolution": "node16",

    "lib": ["ESNext", "DOM"],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,

    "paths": {
      "@pages/*": ["./src/pages/*"],
      "@utils/*": ["./src/utils/*"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@data/*": ["./src/data/*"]
    }
  },

  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
, "src/ai/llmClient.js"  ],

  "exclude": [
    "node_modules",
    "test-results",
    "playwright-report"
  ]
}